<?xml version="1.0" encoding="UTF-8"?>
<MatchingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <matchingRules>
        <fullName>VisitReportMatching</fullName>
        <description>Matches Visit Reports with the same Physician, Visit Date, and Rep. Used by the Visit Report Duplicate Rule (BR-001).</description>
        <label>Visit Report Matching</label>
        <ruleStatus>Active</ruleStatus>
        <matchingRuleItems>
            <fieldName>Physician__c</fieldName>
            <matchingMethod>Exact</matchingMethod>
        </matchingRuleItems>
        <matchingRuleItems>
            <fieldName>Visit_Outcome__c</fieldName>
            <matchingMethod>Exact</matchingMethod>
        </matchingRuleItems>
    </matchingRules>
</MatchingRules>
