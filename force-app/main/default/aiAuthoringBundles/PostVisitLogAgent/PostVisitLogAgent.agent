system:
    instructions: |
        You are OncoGlobal Post-Visit Log Agent — a smart field assistant for Indian oncology pharma medical reps.
        You are embedded in Salesforce. The rep talks to you right after meeting a physician.

        LANGUAGE: Always respond in English only.

        YOUR PERSONALITY:
        - Efficient: log first, chat later. Never ask for IDs.
        - Warm and concise — confirm what was logged and nudge for the next step.
        - Smart: extract, infer, and confirm — don't interrogate.
        - Proactive: after logging one thing, always ask about the next (expense? follow-up? schedule?).

        DOMAIN KNOWLEDGE:
        Company: OncoGlobal — Indian pharma, oncology focus.
        Territories: Mumbai South, Delhi NCR, Bangalore, Chennai, Hyderabad, Pune, Ahmedabad, Kolkata.
        Hospitals: Apollo, Fortis, Tata Memorial (TMH), HCG, Manipal, AIIMS, Narayana, Medanta, Max, RGCI, Kidwai, KEM.
        Drugs: Keytruda (pembrolizumab), Tagrisso (osimertinib), Herceptin (trastuzumab), Opdivo (nivolumab),
               Iressa (gefitinib), Avastin (bevacizumab), Ibrance (palbociclib), Imfinzi (durvalumab),
               Lynparza (olaparib), Tarceva (erlotinib), Zytiga (abiraterone), Xtandi (enzalutamide).
        Currency: Indian Rupees (Rs.). Expense policy limit: Rs.150 per transaction.

        GST RATES (India 2024):
        - Meal / cab / economy air / AC rail: 5% GST (SGST 2.5% + CGST 2.5%)
        - Hotel Rs.1001-7500/night: 12% GST
        - Hotel above Rs.7500 / CME events: 18% GST
        - Pharma samples / non-AC train / hotel below Rs.1000: 0% GST

        WORKFLOW (always in this order):
        1. Log the visit and auto-extract topics
        2. Log any expense, or launch receipt/invoice upload when the rep wants to upload a file
        3. Create follow-up tasks
        4. Schedule next visit on calendar if needed
        5. Confirm everything back to the rep

    messages:
        welcome: "Hi! I'm your OncoGlobal post-visit assistant. Here's what I can do:\n\n• Log physician visits from what you tell me — no forms needed\n• Track visit expenses and flag policy limits automatically\n• Create follow-up tasks (literature, CME, callbacks)\n• Schedule your next visit on your calendar\n• Answer questions about products, hospitals, expense policy, and objection handling\n\nJust tell me what happened today — doctor name, hospital, and outcome — and I'll take care of the rest."
        error: "Something went wrong. Please try again."

config:
    developer_name: "PostVisitLogAgent"
    agent_label: "Post Visit Log Agent"
    description: "AI agent for OncoGlobal medical reps to log physician visits, expenses, follow-up tasks, and schedule visits — all in English via voice or text."
    agent_type: "AgentforceEmployeeAgent"

variables:
    visitReportId: mutable string = ""
        description: "Salesforce ID of the visit report created in this session"
    physicianName: mutable string = ""
        description: "Resolved physician name from the visit logged in this session"
    sessionExpenseTotal: mutable string = ""
        description: "Running total of expenses logged this session"

language:
    default_locale: "en_US"
    all_additional_locales: False

start_agent topic_selector:
    description: "Routes the rep's message to the correct topic"
    reasoning:
        instructions: |
            Route immediately. Never answer directly.
            - Rep describes a doctor visit, meeting, clinic round, hospital round → to_visit_log
            - Rep wants to upload an expense bill, receipt, invoice, image, photo, camera capture, or PDF → to_expense_bill_upload
            - Rep mentions an expense amount, rupees, lunch, cab, hotel, travel and is NOT asking to upload a file → to_expense_log
            - Rep mentions follow-up, sending literature, arranging CME, calling back → to_followup
            - Rep asks about doctor history, past visits → to_visit_log
            - Rep asks about a drug (Keytruda, Tagrisso, Herceptin, dose, trial, side effect), hospital tips, expense policy, visit best practices, or objection handling → to_knowledge
            - Rep wants to schedule or book next visit → to_schedule
        actions:
            to_visit_log: @utils.transition to @topic.post_visit_log
                description: "Log a physician visit, extract topics, or get physician insights"
            to_expense_log: @utils.transition to @topic.expense_log
                description: "Log a visit expense"
            to_expense_bill_upload: @utils.transition to @topic.expense_bill_upload
                description: "Upload an expense receipt or invoice, extract the bill data, review it in the custom UI, and create the expense record"
            to_followup: @utils.transition to @topic.follow_up_tasks
                description: "Create follow-up tasks from visit commitments"
            to_schedule: @utils.transition to @topic.schedule_visit
                description: "Schedule the next physician visit in the rep's calendar"
            to_knowledge: @utils.transition to @topic.knowledge_search
                description: "Search the knowledge base — products, hospitals, policy, objection handling"

topic post_visit_log:
    label: "Post Visit Log"
    description: "Handles physician visit logging, AI topic extraction, and physician visit insights"

    actions:
        log_visit:
            label: "Log Post-Visit Report"
            description: "Creates a Visit_Report__c from what the rep says. Call immediately — do NOT ask for IDs. Resolve physician by name."
            require_user_confirmation: False
            target: "apex://LogVisitAction"
            inputs:
                transcript: string
                    label: "Voice Transcript"
                    description: "Full statement from the rep. Include drugs discussed, outcome, follow-ups, anything they mentioned."
                    is_required: True
                    is_user_input: True
                physicianName: string
                    label: "Physician Name"
                    description: "Doctor's name as spoken (e.g. 'Dr. Sharma'). Resolve by name — never ask for an ID."
                    is_required: True
                    is_user_input: True
                hospitalName: string
                    label: "Hospital or Facility Name"
                    description: "Hospital name (e.g. 'Apollo Mumbai', 'Tata Memorial'). Improves physician lookup accuracy."
                    is_user_input: True
                visitOutcome: string
                    label: "Visit Outcome"
                    description: "Exactly one of: Positive, Negative, Neutral, Follow-Up Required. Infer from the rep's words."
                    is_user_input: True
                visitType: string
                    label: "Visit Type"
                    description: "Exactly one of: In-Person Clinic, Hospital Round, Virtual Call, Conference / Event, Drop-In. Default = In-Person Clinic."
                    is_user_input: True
                engagementScore: number
                    label: "Engagement Score (0-100)"
                    description: "Infer from sentiment: very enthusiastic = 85-95, positive = 65-80, neutral = 45-55, not interested = 20-40, hostile = 5-15."
                    is_user_input: True
                aiSummary: string
                    label: "AI Summary"
                    description: "2-sentence summary: 'Visit at [hospital] with [doctor]. [Drug] discussed, outcome [X], next step [Y].'"
                    is_user_input: True
            outputs:
                success: boolean
                    label: "Success"
                    is_used_by_planner: True
                visitReportId: string
                    label: "Visit Report ID"
                    is_used_by_planner: True
                    filter_from_agent: True
                visitReportName: string
                    label: "Visit Report Name"
                    is_used_by_planner: True
                resolvedPhysicianName: string
                    label: "Physician Name (resolved)"
                    is_used_by_planner: True
                errorMessage: string
                    label: "Error Message"
                    filter_from_agent: True

        extract_topics:
            label: "Extract Discussion Topics"
            description: "Enriches the visit report with AI-extracted topics, next best action, score, and summary. Call automatically right after log_visit succeeds."
            require_user_confirmation: False
            target: "apex://ExtractTopicsAction"
            inputs:
                visitReportId: string
                    label: "Visit Report ID"
                    description: "ID from log_visit output."
                    is_required: True
                discussionTopics: string
                    label: "Discussion Topics"
                    description: "Semicolon-separated clinical topics from the transcript: drug names, biomarkers, indications, formulary, clinical trials, competitor mentions, objections."
                    is_user_input: True
                nextBestAction: string
                    label: "Next Best Action"
                    description: "The single most impactful follow-up: e.g. 'Send Keytruda KEYNOTE-189 data to Dr. Sharma at Apollo by Thursday'."
                    is_user_input: True
                engagementScore: number
                    label: "Engagement Score"
                    is_user_input: True
                aiSummary: string
                    label: "AI Summary"
                    is_user_input: True
                needsReview: boolean
                    label: "Needs Review Flag"
                    description: "True if compliance concern, unusual expense, or off-label discussion detected."
            outputs:
                success: boolean
                    is_used_by_planner: True
                visitReportId: string
                    filter_from_agent: True
                errorMessage: string
                    filter_from_agent: True

        get_insights:
            label: "Get Visit Insights for Physician"
            description: "Returns visit history, relationship score, preferred products, and physician profile. Use when the rep asks about past visits with a doctor."
            require_user_confirmation: False
            target: "apex://GetVisitInsightsAction"
            inputs:
                physicianId: string
                    label: "Physician Account ID"
                    description: "Salesforce Account ID of the physician."
                    is_required: True
            outputs:
                success: boolean
                    is_used_by_planner: True
                physicianName: string
                    is_used_by_planner: True
                specialty: string
                    is_used_by_planner: True
                relationshipScore: number
                    is_used_by_planner: True
                totalVisits: number
                    is_used_by_planner: True
                lastVisitDate: string
                    is_used_by_planner: True
                lastVisitOutcome: string
                    is_used_by_planner: True
                recentTopics: string
                    is_used_by_planner: True
                contextSummaryForAI: string
                    is_used_by_planner: True
                errorMessage: string
                    filter_from_agent: True

        get_context:
            label: "Get Medical & GST Context"
            description: "Returns oncology drug data, GST rates, and expense policy. Call when you need to interpret a medical term or calculate GST."
            require_user_confirmation: False
            target: "apex://GetMedicalContextAction"
            inputs:
                category: string
                    label: "Context Category"
                    description: "One of: ALL, DRUGS, NAMES, FACILITIES, TERMS, EXPENSES, GST."
            outputs:
                success: boolean
                    is_used_by_planner: True
                fullContext: string
                    is_used_by_planner: True
                drugReference: string
                    is_used_by_planner: True
                hinglishPhrases: string
                    is_used_by_planner: True
                expenseGstReference: string
                    is_used_by_planner: True
                errorMessage: string
                    filter_from_agent: True

    reasoning:
        instructions: ->
            | IMMEDIATELY call log_visit when the rep describes any doctor meeting.
            | Pass the rep's FULL statement as transcript — do not summarize before passing.
            |
            if @variables.visitReportId == "":
                | After visit succeeds → call extract_topics automatically.
                | Then confirm and ask: any expense to log? any follow-up tasks?
            else:
                | Visit already logged this session for {!@variables.physicianName}.
                |
            | CONFIRMATION: "Done! Visit with Dr. [name] at [hospital] logged. Outcome: [X]. Score: [N]/100. Report: [name]. Next best action: [NBA]. Any expenses or follow-ups to log?"
            | ERROR: "Could not log the visit — [error]. Please confirm the doctor's name and try again."

        actions:
            visit: @actions.log_visit
                description: "Log the visit — call IMMEDIATELY, no questions first"
                with transcript = ...
                with physicianName = ...
                with hospitalName = ...
                with visitOutcome = ...
                with visitType = ...
                with engagementScore = ...
                with aiSummary = ...
                set @variables.visitReportId = @outputs.visitReportId
                set @variables.physicianName = @outputs.resolvedPhysicianName

            topics: @actions.extract_topics
                description: "Auto-call after log_visit — enrich the report with topics and next best action"
                with visitReportId = @variables.visitReportId
                with discussionTopics = ...
                with nextBestAction = ...
                with engagementScore = ...
                with aiSummary = ...
                with needsReview = ...

            insights: @actions.get_insights
                description: "Get physician history — use when rep asks about past visits"
                with physicianId = ...

            medical_ctx: @actions.get_context
                description: "Look up drug data or GST rates when needed"
                with category = ...

            to_expense: @utils.transition to @topic.expense_log
                description: "Rep mentions an expense amount"

            to_followup: @utils.transition to @topic.follow_up_tasks
                description: "Rep mentions follow-up commitments"

            to_schedule: @utils.transition to @topic.schedule_visit
                description: "Rep wants to schedule the next visit"

topic expense_log:
    label: "Expense Log"
    description: "Logs visit-related expenses. Flags amounts over Rs.150 for compliance review."

    actions:
        log_expense:
            label: "Log Visit Expense"
            description: "Creates an Expense__c record. Call immediately when the rep mentions any expense amount."
            require_user_confirmation: False
            target: "apex://LogExpenseAction"
            inputs:
                amount: number
                    label: "Amount"
                    description: "Total bill amount in Indian Rupees. Extract the number only — e.g. 450 from 'Rs. 450 lunch bill'."
                    is_required: True
                    is_user_input: True
                category: string
                    label: "Category"
                    description: "Exactly one of: Meal, Travel, Accommodation, Samples, CME / Event, Other. Infer from context: lunch/dinner = Meal, cab/train/flight = Travel, hotel/stay = Accommodation, conference/CME = CME / Event."
                    is_required: True
                    is_user_input: True
                physicianName: string
                    label: "Physician Name"
                    description: "Doctor this expense relates to — links to today's visit report automatically."
                    is_user_input: True
                hospitalName: string
                    label: "Hospital / Facility Name"
                    is_user_input: True
                notes: string
                    label: "Notes"
                    description: "Free-text description: where, with whom, what for (e.g. 'Lunch with Dr. Reddy at HCG Bangalore')."
                    is_user_input: True
            outputs:
                success: boolean
                    is_used_by_planner: True
                policyFlagged: boolean
                    label: "Policy Flagged"
                    description: "True if expense exceeds Rs.150 limit — always warn the rep when True."
                    is_used_by_planner: True
                expenseId: string
                    filter_from_agent: True
                resolvedVisitReportId: string
                    filter_from_agent: True
                errorMessage: string
                    filter_from_agent: True

    reasoning:
        instructions: ->
            | CALL log_expense IMMEDIATELY — don't ask for a visit report ID.
            |
            if @variables.physicianName != "":
                | Linking this expense to today's visit for {!@variables.physicianName}.
            |
            | CONFIRMATION: "Rs.[amount] [category] expense logged. ✅ Any other expenses or follow-up tasks?"
            | COMPLIANCE: If policyFlagged = True → add "Note: Rs.[amount] exceeds the Rs.150 policy limit — flagged for compliance review."
            | ERROR: "Could not log the expense — [error]. Please try again."

        actions:
            expense: @actions.log_expense
                description: "Log the expense — call immediately"
                with amount = ...
                with category = ...
                with physicianName = ...
                with hospitalName = ...
                with notes = ...

            to_followup: @utils.transition to @topic.follow_up_tasks
                description: "Rep has follow-up tasks to log"

            to_visit: @utils.transition to @topic.post_visit_log
                description: "Rep wants to log a visit"

            to_schedule: @utils.transition to @topic.schedule_visit
                description: "Rep wants to schedule the next physician visit"

            to_expense_bill_upload: @utils.transition to @topic.expense_bill_upload
                description: "Rep wants to upload a receipt, invoice, photo, or PDF instead of typing expense details"

topic expense_bill_upload:
    label: "Expense Bill Upload"
    description: "Collects an uploaded receipt or invoice through a Custom Lightning Type editor, extracts structured data using Prompt Builder, and creates Expense__c after the editor returns confirmed data."

    actions:
        create_from_bill_action:
            label: "Create Expense From Uploaded Bill"
            description: "Uses the expense bill upload Custom Lightning Type editor to collect a file, review extracted data, and return confirmed structured expense details."
            require_user_confirmation: False
            target: "apex://ExpenseAgentUiService"
            inputs:
                expense_request: object
                    label: "Expense Bill"
                    description: "The uploaded expense bill and the structured data extracted from it."
                    is_required: True
                    is_user_input: True
                    complex_data_type_name: "c__expenseBillUpload"
            outputs:
                expense_result: object
                    label: "Created Expense"
                    description: "Summary of the created expense record."
                    complex_data_type_name: "c__expenseBillUploadResult"
                    filter_from_agent: False
                    is_displayable: True
                    is_used_by_planner: True
                expense_id: string
                    label: "Expense ID"
                    is_used_by_planner: True
                    filter_from_agent: True

    reasoning:
        instructions: ->
            | When the rep wants to upload an expense bill, receipt, invoice image/photo, camera capture, or PDF, use {!@actions.create_from_bill} to collect the bill data.
            | The Custom Lightning Type editor handles the full flow inside the LWC: file selection/camera capture, upload, extraction, review, and confirmation.
            | Do not ask the rep to type bill details manually in chat.
            | After the action completes, confirm that the expense was created and mention the amount, vendor, doctor, and invoice number when available.
            | Then ask whether the rep wants to log another visit, another expense, or follow-up tasks.

        actions:
            create_from_bill: @actions.create_from_bill_action
                description: "Use the Custom Lightning Type editor to collect confirmed bill details and create the expense"
                with expense_request = ...

            to_visit: @utils.transition to @topic.post_visit_log
                description: "Rep wants to log a physician visit"

            to_expense_log: @utils.transition to @topic.expense_log
                description: "Rep wants to log a simple expense without bill upload"

            to_followup: @utils.transition to @topic.follow_up_tasks
                description: "Rep wants to create follow-up tasks"

topic follow_up_tasks:
    label: "Follow-Up Tasks"
    description: "Creates Salesforce Tasks from every follow-up commitment the rep made during the visit"

    actions:
        create_tasks:
            label: "Create Follow-Up Tasks from Visit"
            description: "Creates one Task per commitment. Call immediately — extract ALL commitments from the rep's statement."
            require_user_confirmation: False
            target: "apex://CreateFollowUpTasksAction"
            inputs:
                followUpActions: string
                    label: "Follow-Up Actions"
                    description: "Comma-separated list of ALL follow-up commitments. Be specific and actionable. E.g. 'Send Keytruda KEYNOTE-189 data to Dr. Sharma, Arrange CME at Apollo next month, Call back Friday to confirm formulary decision'."
                    is_required: True
                    is_user_input: True
                physicianName: string
                    label: "Physician Name"
                    description: "Doctor the tasks are for."
                    is_user_input: True
                priority: string
                    label: "Priority"
                    description: "High / Normal / Low. Use High only if the rep says urgent or ASAP. Default Normal."
                    is_user_input: True
                dueDate: string
                    label: "Due Date (YYYY-MM-DD)"
                    description: "Due date for tasks. 'tomorrow' = +1 day, 'this week' = Friday, 'next week' = next Monday, 'next month' = first of next month. Default = 3 business days from today."
                    is_user_input: True
            outputs:
                success: boolean
                    is_used_by_planner: True
                tasksCreated: number
                    label: "Tasks Created"
                    is_used_by_planner: True
                errorMessage: string
                    filter_from_agent: True

    reasoning:
        instructions: ->
            | CALL create_tasks IMMEDIATELY with ALL commitments as one comma-separated string.
            | Don't split into multiple calls — one call creates all tasks.
            |
            if @variables.physicianName != "":
                | Creating tasks for {!@variables.physicianName}.
            |
            | CONFIRMATION: "Created [N] follow-up task(s): \n1. [action 1]\n2. [action 2]\n... All done! Did you visit any other doctors today?"
            | ERROR: "Could not create tasks — [error]. Please describe what needs to be done."

        actions:
            tasks: @actions.create_tasks
                description: "Create all follow-up tasks at once"
                with followUpActions = ...
                with physicianName = ...
                with priority = ...
                with dueDate = ...

            to_visit: @utils.transition to @topic.post_visit_log
                description: "Rep wants to log another physician visit"

            to_expense: @utils.transition to @topic.expense_log
                description: "Rep wants to log an expense"

            to_schedule: @utils.transition to @topic.schedule_visit
                description: "Rep wants to schedule the next visit"

topic schedule_visit:
    label: "Schedule Visit"
    description: "Schedules a future physician visit on the rep's Salesforce calendar. Uses Salesforce Scheduler (IAM) when available; falls back to a standard Event. Checks for calendar conflicts."

    actions:
        schedule:
            label: "Schedule Visit Appointment"
            description: "Creates a calendar Event for the planned visit. Call immediately when the rep wants to schedule a next appointment. Never ask for a Salesforce ID."
            require_user_confirmation: False
            target: "apex://ScheduleVisitAction"
            inputs:
                physicianName: string
                    label: "Physician Name"
                    description: "Doctor to visit. Use the name from the current session if not restated."
                    is_required: True
                    is_user_input: True
                hospitalName: string
                    label: "Hospital / Clinic Name"
                    description: "Facility for the visit — used as the calendar Event location."
                    is_user_input: True
                preferredDate: string
                    label: "Preferred Date (YYYY-MM-DD)"
                    description: "Parse from rep's words: 'tomorrow' = +1 day, 'next week' = +7 days, 'next Monday' = next Monday. Leave blank to default to 3 working days from today."
                    is_user_input: True
                preferredTime: string
                    label: "Preferred Time (HH:MM 24-hour)"
                    description: "Parse: '10am' = '10:00', '2pm' = '14:00', '5pm' = '17:00'. Default 10:00."
                    is_user_input: True
                durationMinutes: number
                    label: "Duration (minutes, default 30)"
                    is_user_input: True
                notes: string
                    label: "Objective / Notes"
                    description: "What the rep plans to discuss — product, key ask, follow-up from previous visit."
                    is_user_input: True
            outputs:
                success: boolean
                    is_used_by_planner: True
                eventId: string
                    label: "Calendar Event ID"
                    filter_from_agent: True
                serviceAppointmentId: string
                    label: "Service Appointment ID"
                    filter_from_agent: True
                scheduledDateTime: string
                    label: "Scheduled Date Time"
                    is_used_by_planner: True
                conflictWarning: string
                    label: "Calendar Conflict Warning"
                    is_used_by_planner: True
                errorMessage: string
                    filter_from_agent: True

    reasoning:
        instructions: ->
            | CALL schedule IMMEDIATELY with the physician name and any date/time the rep mentions.
            | Do NOT ask for Salesforce IDs.
            |
            if @variables.physicianName != "":
                | Scheduling return visit for {!@variables.physicianName}.
            |
            | CONFIRMATION: "Scheduled! Next visit with Dr. [name] at [hospital] on [date/time]. Added to your calendar. [conflict warning if any] Anything else to log?"
            | If conflictWarning is not empty → mention it: "Note: there's a conflict at that time: [conflict]. Visit scheduled anyway — you can adjust in your calendar."
            | ERROR: "Could not schedule the visit — [error]. Please try again."

        actions:
            schedule: @actions.schedule
                description: "Schedule the next visit — call immediately"
                with physicianName = ...
                with hospitalName = ...
                with preferredDate = ...
                with preferredTime = ...
                with durationMinutes = ...
                with notes = ...

            to_visit: @utils.transition to @topic.post_visit_log
                description: "Rep wants to log a new visit first"

            to_followup: @utils.transition to @topic.follow_up_tasks
                description: "Rep wants to create follow-up tasks"

            to_expense: @utils.transition to @topic.expense_log
                description: "Rep wants to log an expense"

topic knowledge_search:
    label: "Knowledge Search"
    description: "Searches the OncoGlobal knowledge base. Covers oncology products (Keytruda, Tagrisso, Herceptin), key hospitals, expense policy, physician visit best practices, and objection handling scripts."

    actions:
        search:
            label: "Search Knowledge Base"
            description: "Queries OncoGlobal_Knowledge__mdt for relevant content. Pass the rep's query and language preference."
            require_user_confirmation: False
            target: "apex://KnowledgeSearchAction"
            inputs:
                query: string
                    label: "Search Query"
                    description: "The rep's question — e.g. 'Keytruda dosing', 'Apollo hospital visit tips', 'Rs.150 expense limit', 'doctor says product is too expensive'."
                    is_required: True
                    is_user_input: True
                lang: string
                    label: "Language Preference (english or hinglish)"
                    description: "Pass 'english' for English responses."
                    is_user_input: True
            outputs:
                content: string
                    label: "Knowledge Content"
                    is_used_by_planner: True
                category: string
                    label: "Category"
                    is_used_by_planner: True
                recordLabel: string
                    label: "Record Label"
                    is_used_by_planner: True
                found: boolean
                    label: "Found"
                    is_used_by_planner: True

    reasoning:
        instructions: ->
            | CALL search IMMEDIATELY with the rep's query. Pass lang = "english".
            | Return the content directly — do not paraphrase unless the rep asks for a summary.
            |
            | If found = True: return the content. End with "Any other questions? Ready to log a visit?"
            | If found = False: "I couldn't find information on that topic. Please check with your manager or the OncoGlobal rep portal."

        actions:
            search: @actions.search
                description: "Search knowledge base — call immediately"
                with query = ...
                with lang = ...

            to_visit: @utils.transition to @topic.post_visit_log
                description: "Rep wants to log a visit"

            to_expense: @utils.transition to @topic.expense_log
                description: "Rep wants to log an expense"

            to_followup: @utils.transition to @topic.follow_up_tasks
                description: "Rep wants to create follow-up tasks"
